    "def odd(*num):\n",
    "    odds = []\n",
    "    for i in num:\n",
    "        if i % 2 != 0:\n",
    "            odds.append(i)\n",
    "    print(odds)\n",
    "\n",
    "odd(1,2,3,4,5)"
   ]
  }
